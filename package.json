{
  "private": true,
  "name": "versatiles-landcover",
  "version": "1.0.0",
  "description": "Generate landcover vector tiles from ESA Worldcover",
  "author": "Michael Kreil <github@michael-kreil.de>, yetzt <node@yetzt.me>",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning bin/build.ts",
    "check": "npm run typecheck && npm run format:check && npm test",
    "clean": "node bin/clean.ts",
    "dev": "node bin/dev.ts",
    "doctor": "node bin/doctor.ts",
    "download": "node bin/download.ts",
    "experiment": "node --disable-warning=ExperimentalWarning bin/experiment.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "inspect": "node --disable-warning=ExperimentalWarning bin/inspect.ts",
    "preview": "node --disable-warning=ExperimentalWarning bin/preview.ts",
    "stats": "node --disable-warning=ExperimentalWarning bin/stats.ts",
    "style": "node bin/style.ts",
    "sweep": "node --disable-warning=ExperimentalWarning bin/sweep.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
    "timings": "node bin/timings.ts",
    "typecheck": "tsc --noEmit",
    "upgrade": "npx npm-check-updates -u && npm install && npm audit fix"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@versatiles/style": "^7.1.0",
    "@versatiles/versatiles-rs": "^5.6.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
